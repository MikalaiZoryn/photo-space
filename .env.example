# Optional overrides for local development. Copy to .env (git-ignored) only if you need to change them.
# Docker Compose reads .env automatically. The backend reads these from the environment
# (for example: set -a; source .env; set +a; cd backend && ./mvnw spring-boot:run).

# Host port for the local PostgreSQL container (compose.yaml).
POSTGRES_PORT=5432

# Backend datasource. The defaults in application.yml already match compose.yaml.
DB_URL=jdbc:postgresql://localhost:5432/photospace
DB_USERNAME=photospace
DB_PASSWORD=photospace

# Local S3 emulator (compose.yaml) for photo storage. Deployed environments set STORAGE_BUCKET and AWS_REGION
# and set STORAGE_ENDPOINT to an empty value, so the real S3 endpoint and the task role's credentials are used.
S3_PORT=9090
STORAGE_ENDPOINT=http://localhost:9090
STORAGE_BUCKET=photo-space-local
AWS_REGION=eu-central-1

# Local SQS emulator (compose.yaml) for background jobs. Deployed environments set JOBS_QUEUE_URL and an empty
# JOBS_SQS_ENDPOINT.
SQS_PORT=9324
JOBS_SQS_ENDPOINT=http://localhost:9324
JOBS_QUEUE_URL=http://localhost:9324/000000000000/photo-space-jobs
# Which job roles this process runs. Locally both; Milestone 8 splits them between the API and worker services.
# JOBS_DISPATCHER_ENABLED=true
# JOBS_WORKER_ENABLED=true

# Google sign-in (optional). Without these, use the dev sign-in described in the README.
# Create an OAuth client ("Web application") in Google Cloud Console and add the authorized redirect URI
#   http://localhost:5173/api/auth/oauth2/callback/google
# Never commit real values: .env is git-ignored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The session cookie is Secure by default. Chrome and Firefox accept that on http://localhost.
# Set to false only for a local browser that does not (for example Safari).
# SESSION_COOKIE_SECURE=false

# AI content drafts (D16). The default "mock" provider writes sample text locally and sends nothing anywhere.
# With "anthropic", selected photo previews, the notes typed in the request, the session type, and the brand
# profile go to the Claude API. Never commit a real key: .env is git-ignored.
# CONTENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
