# Optional overrides for local development. Copy to .env (git-ignored) only if you need to change them.
# Docker Compose reads .env automatically. The backend reads these from the environment
# (for example: set -a; source .env; set +a; cd backend && ./mvnw spring-boot:run).

# Host port for the local PostgreSQL container (compose.yaml).
POSTGRES_PORT=5432

# Backend datasource. The defaults in application.yml already match compose.yaml.
DB_URL=jdbc:postgresql://localhost:5432/photospace
DB_USERNAME=photospace
DB_PASSWORD=photospace

# Google sign-in (optional). Without these, use the dev sign-in described in the README.
# Create an OAuth client ("Web application") in Google Cloud Console and add the authorized redirect URI
#   http://localhost:5173/api/auth/oauth2/callback/google
# Never commit real values: .env is git-ignored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The session cookie is Secure by default. Chrome and Firefox accept that on http://localhost.
# Set to false only for a local browser that does not (for example Safari).
# SESSION_COOKIE_SECURE=false
